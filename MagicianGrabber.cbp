<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="MagicianGrabber" />
		<Option pch_mode="2" />
		<Option compiler="gcc" />
		<Build>
			<Target title="Debug">
				<Option output="./magician_grabber" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-g" />
				</Compiler>
				<Linker>
					<Add option="-pthread" />
					<Add option="-lm" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="./magician_grabber" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="gcc" />
				<Compiler>
					<Add option="-O2" />
				</Compiler>
				<Linker>
					<Add option="-s" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
			<Add option="`pkg-config --cflags aravis-0.10`" />
			<Add option="`pkg-config --libs aravis-0.10 `" />
			<Add option="-D_GNU_SOURCE" />
		</Compiler>
		<Linker>
			<Add option="-lm" />
			<Add option="`pkg-config --libs aravis-0.10 `" />
			<Add option="-lpthread" />
		</Linker>
		<Unit filename="src/arduinoSensor.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/arduinoSensor.h" />
		<Unit filename="src/atiForceSensor.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/atiForceSensor.h" />
		<Unit filename="src/callbacks.h" />
		<Unit filename="src/colors.h" />
		<Unit filename="src/common.h" />
		<Unit filename="src/gigeCameraSensor.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/gigeCameraSensor.h" />
		<Unit filename="src/imageStreamer.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/imageStreamer.h" />
		<Unit filename="src/multiModalGrabber.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/performance.h" />
		<Unit filename="src/resolveUSBDevice.h" />
		<Unit filename="src/sharedMemoryVideoBuffers.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/sharedMemoryVideoBuffers.h" />
		<Unit filename="src/tactileFeatures.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/tactileFeatures.h" />
		<Unit filename="src/tactileStreamer.c">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="src/tactileStreamer.h" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
